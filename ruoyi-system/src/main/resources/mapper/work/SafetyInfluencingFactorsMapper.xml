<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.work.SafetyInfluencingFactorsMapper">

    <resultMap type="com.ruoyi.system.domain.work.SafetyInfluencingFactors" id="SafetyInfluencingFactorsResult">
        <result property="id"    column="id"    />
        <result property="unitName"    column="unit_name"    />
        <result property="unitCode"    column="unit_code"    />
        <result property="recordDate"    column="record_date"    />
        <result property="remarks"    column="remarks"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectSafetyInfluencingFactorsVo">
        select id, unit_name, unit_code, record_date, remarks, create_time from safety_influencing_factors
    </sql>

    <select id="selectSafetyInfluencingFactorsList" parameterType="com.ruoyi.system.domain.work.SafetyInfluencingFactors" resultMap="SafetyInfluencingFactorsResult">
        <include refid="selectSafetyInfluencingFactorsVo"/>
        <where>
            <if test="unitName != null  and unitName != ''"> and unit_name like concat('%', #{unitName}, '%')</if>
            <if test="unitCode != null  and unitCode != ''"> and unit_code = #{unitCode}</if>
            <if test="recordDate != null "> and record_date = #{recordDate}</if>
            <if test="remarks != null  and remarks != ''"> and remarks = #{remarks}</if>
        </where>
    </select>

    <select id="selectSafetyInfluencingFactorsById" parameterType="java.lang.Long" resultMap="SafetyInfluencingFactorsResult">
        <include refid="selectSafetyInfluencingFactorsVo"/>
        where id = #{id}
    </select>

    <insert id="insertSafetyInfluencingFactors" parameterType="com.ruoyi.system.domain.work.SafetyInfluencingFactors" useGeneratedKeys="true" keyProperty="id">
        insert into safety_influencing_factors
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="unitName != null">unit_name,</if>
            <if test="unitCode != null">unit_code,</if>
            <if test="recordDate != null">record_date,</if>
            <if test="remarks != null">remarks,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="unitName != null">#{unitName},</if>
            <if test="unitCode != null">#{unitCode},</if>
            <if test="recordDate != null">#{recordDate},</if>
            <if test="remarks != null">#{remarks},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateSafetyInfluencingFactors" parameterType="com.ruoyi.system.domain.work.SafetyInfluencingFactors">
        update safety_influencing_factors
        <trim prefix="SET" suffixOverrides=",">
            <if test="unitName != null">unit_name = #{unitName},</if>
            <if test="unitCode != null">unit_code = #{unitCode},</if>
            <if test="recordDate != null">record_date = #{recordDate},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSafetyInfluencingFactorsById" parameterType="java.lang.Long">
        delete from safety_influencing_factors where id = #{id}
    </delete>

    <delete id="deleteSafetyInfluencingFactorsByIds" parameterType="java.lang.String">
        delete from safety_influencing_factors where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>