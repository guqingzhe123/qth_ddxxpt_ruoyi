<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TProductInfoMapper">
    
    <resultMap type="TProductInfo" id="TProductInfoResult">
        <result property="id"    column="id"    />
        <result property="productCode"    column="product_code"    />
        <result property="productName"    column="product_name"    />
        <result property="taxRate"    column="tax_rate"    />
        <result property="unit"    column="unit"    />
        <result property="isActive"    column="is_active"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTProductInfoVo">
        select id, product_code, product_name, tax_rate, unit, is_active, create_time, update_time from t_product_info
    </sql>

    <select id="selectTProductInfoList" parameterType="TProductInfo" resultMap="TProductInfoResult">
        <include refid="selectTProductInfoVo"/>
        <where>  
            <if test="productCode != null  and productCode != ''"> and product_code = #{productCode}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="taxRate != null "> and tax_rate = #{taxRate}</if>
            <if test="unit != null  and unit != ''"> and unit = #{unit}</if>
            <if test="isActive != null "> and is_active = #{isActive}</if>
        </where>
    </select>
    
    <select id="selectTProductInfoById" parameterType="Long" resultMap="TProductInfoResult">
        <include refid="selectTProductInfoVo"/>
        where id = #{id}
    </select>

    <insert id="insertTProductInfo" parameterType="TProductInfo" useGeneratedKeys="true" keyProperty="id">
        insert into t_product_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="productCode != null and productCode != ''">product_code,</if>
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="taxRate != null">tax_rate,</if>
            <if test="unit != null and unit != ''">unit,</if>
            <if test="isActive != null">is_active,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="productCode != null and productCode != ''">#{productCode},</if>
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="taxRate != null">#{taxRate},</if>
            <if test="unit != null and unit != ''">#{unit},</if>
            <if test="isActive != null">#{isActive},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTProductInfo" parameterType="TProductInfo">
        update t_product_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="productCode != null and productCode != ''">product_code = #{productCode},</if>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="taxRate != null">tax_rate = #{taxRate},</if>
            <if test="unit != null and unit != ''">unit = #{unit},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTProductInfoById" parameterType="Long">
        delete from t_product_info where id = #{id}
    </delete>

    <delete id="deleteTProductInfoByIds" parameterType="String">
        delete from t_product_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>