<mapper namespace="com.ruoyi.system.mapper.SubInitialInventoryOfEachMineMapper">
    
    <resultMap type="com.ruoyi.system.domain.SubInitialInventoryOfEachMine" id="SubInitialInventoryOfEachMineResult">
        <result property="id"    column="id"    />
        <result property="initialInventoryId"    column="initial_inventory_id"    />
        <result property="unitName"    column="unit_name"    />
        <result property="initialInventoryOfThisMonth"    column="initial_inventory_of_this_month"    />
        <result property="isReject"    column="is_reject"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
