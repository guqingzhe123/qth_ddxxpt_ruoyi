<mapper namespace="com.ruoyi.system.mapper.export.WDailyReportMapper">
    
    <resultMap type="WDailyReport" id="WDailyReportResult">
        <result property="id"    column="id"    />
        <result property="statsDate"    column="stats_date"    />
        <result property="company"    column="company"    />
        <result property="type"    column="type"    />
        <result property="totalDaily"    column="total_daily"    />
        <result property="totalAcc"    column="total_acc"    />
        <result property="railDaily"    column="rail_daily"    />
        <result property="railAcc"    column="rail_acc"    />
        <result property="mineRailDaily"    column="mine_rail_daily"    />
        <result property="mineRailAcc"    column="mine_rail_acc"    />
        <result property="roadDaily"    column="road_daily"    />
        <result property="roadAcc"    column="road_acc"    />
        <result property="portDaily"    column="port_daily"    />
