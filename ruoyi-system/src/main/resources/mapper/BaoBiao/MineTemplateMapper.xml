<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BaoBiao.MineTemplateMapper">

    <!-- 和数据库列名完全一致的映射 -->
    <resultMap id="MineTemplateMap" type="com.ruoyi.system.domain.BaoBiao.MineTemplate">
        <id     property="id"        column="id"/>
        <result property="unitCode"  column="unitCode"/>
        <result property="name"      column="Name"/>
        <result property="Userid"      column="user_id"/>
    </resultMap>

    <!-- 注意：列名大小写与反引号 -->
    <sql id="Base_Column_List">
        id, unitCode, `Name`,`user_id`
    </sql>

    <select id="selectById" resultMap="MineTemplateMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `Mine_template`
        WHERE id = #{id}
    </select>

    <select id="selectList" parameterType="com.ruoyi.system.domain.BaoBiao.MineTemplate" resultMap="MineTemplateMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `Mine_template`
        <where>
            <if test="unitCode != null and unitCode != ''">
                AND unitCode = #{unitCode}
            </if>
            <if test="name != null and name != ''">
                AND `Name` LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="Userid != null and Userid != ''">
                AND `User_id` LIKE CONCAT('%', #{Userid}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>


    <!-- 根据 User_id 查询模板列表 -->
    <select id="selectByUserId" parameterType="com.ruoyi.system.domain.BaoBiao.MineTemplate">
        SELECT <include refid="Base_Column_List"/>
        FROM `Mine_template`
        <where>
            <!-- 仅通过 User_id 过滤，支持模糊查询 -->
            <if test="userId != null and userId != ''">
                AND `User_id` LIKE CONCAT('%', #{userId}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <insert id="insert" parameterType="com.ruoyi.system.domain.BaoBiao.MineTemplate"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `Mine_template` (unitCode, `Name`, `user_id`)
        VALUES (#{unitCode}, #{name}, #{Userid})
    </insert>


    <update id="update" parameterType="com.ruoyi.system.domain.BaoBiao.MineTemplate">
        UPDATE `Mine_template`
        SET unitCode = #{unitCode},
            `Name`   = #{name}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `Mine_template` WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM `Mine_template` WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
