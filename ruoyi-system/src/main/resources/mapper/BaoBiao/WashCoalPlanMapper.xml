<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BaoBiao.WashCoalPlanMapper">

    <resultMap id="WashCoalPlanMap" type="com.ruoyi.system.domain.BaoBiao.po.WashCoalPlanPO">
        <id     column="id"                property="id"/>
        <result column="plan_month"        property="planMonth"/>
        <result column="work_days_in_month" property="workDaysInMonth"/>
        <result column="create_time"       property="createTime"/>
        <result column="update_time"       property="updateTime"/>
        <result column="user_id"           property="userId"/>
        <result column="is_deleted"        property="isDeleted"/>
        <result column="mine_category"     property="mineCategory"/>
    </resultMap>

    <sql id="Base_Columns">
        id, plan_month, work_days_in_month, create_time, update_time, user_id, is_deleted, mine_category
    </sql>

    <insert id="insert" parameterType="com.ruoyi.system.domain.BaoBiao.po.WashCoalPlanPO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO wash_coal_plan
            (plan_month, work_days_in_month, user_id, is_deleted, mine_category)
        VALUES
            (#{planMonth}, #{workDaysInMonth}, #{userId}, 0, #{mineCategory})
    </insert>

    <update id="update" parameterType="com.ruoyi.system.domain.BaoBiao.po.WashCoalPlanPO">
        UPDATE wash_coal_plan
        SET plan_month = #{planMonth},
            work_days_in_month = #{workDaysInMonth},
            user_id = #{userId},
            mine_category = #{mineCategory}
        WHERE id = #{id} AND is_deleted = 0
    </update>

    <update id="softDeleteById">
        UPDATE wash_coal_plan SET is_deleted = 1 WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="WashCoalPlanMap">
        SELECT <include refid="Base_Columns"/> FROM wash_coal_plan
        WHERE id = #{id} AND is_deleted = 0
        LIMIT 1
    </select>

    <select id="selectList" resultMap="WashCoalPlanMap" parameterType="com.ruoyi.system.domain.BaoBiao.po.WashCoalPlanPO">
        SELECT <include refid="Base_Columns"/> FROM wash_coal_plan
        <where>
            <if test="isDeleted != null">AND is_deleted = #{isDeleted}</if>
            <if test="isDeleted == null">AND is_deleted = 0</if>
            <if test="mineCategory != null and mineCategory != ''">AND mine_category = #{mineCategory}</if>
            <if test="userId != null and userId != ''">AND user_id = #{userId}</if>
            <if test="planMonth != null">AND plan_month = #{planMonth}</if>
        </where>
        ORDER BY plan_month DESC, id DESC
    </select>
    <select id="selectByPlan" resultMap="WashCoalPlanMap">
        SELECT <include refid="Base_Columns"/> FROM wash_coal_plan
        WHERE plan_month = #{planMonth} AND is_deleted = 0
        LIMIT 1
    </select>
</mapper>

